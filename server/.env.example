# Copy to server/.env and fill in. Never commit the real file.

# Shared secret the here.now proxy injects as X-DubDeck-Key. Same value as the
# here.now account variable DUBDECK_BACKEND_KEY. Generate: openssl rand -hex 32
DUBDECK_BACKEND_KEY=

# Separate secret for the 15-minute signed download URLs. Generate: openssl rand -hex 32
DUBDECK_SIGNING_SECRET=

# Public https URL of this backend (your Cloudflare Tunnel hostname, or the Render/Fly URL).
# Signed download links point here.
DUBDECK_PUBLIC_URL=https://dubdeck-api.example.com

# OAuth 2.0 Web client ID from Google Cloud Console (APIs & Services > Credentials).
DUBDECK_GOOGLE_CLIENT_ID=

# Optional: also refresh the allowlist from GitHub every 5 minutes (useful on Render/Fly).
# For a private repo, use the API URL and a fine-grained token with Contents: read.
# DUBDECK_ALLOWLIST_URL=https://api.github.com/repos/OWNER/DubDeck/contents/config/allowed-emails.json
# DUBDECK_ALLOWLIST_TOKEN=

# Optional: Netscape cookies.txt for sites that need sign-in (age-restricted, members-only).
# Mount it read-only into the container, e.g. /data/cookies.txt
# DUBDECK_COOKIES_FILE=/data/cookies.txt

# Optional tuning
# DUBDECK_SESSION_DAYS=30
# DUBDECK_SIGNED_URL_TTL=900
