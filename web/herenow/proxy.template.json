{
  "proxies": {
    "/gv/*": {
      "upstream": "https://redirector.googlevideo.com",
      "method": "GET",
      "rateLimit": "3000/hour/ip"
    },
    "/sn/*": {
      "upstream": "https://youtube-info-download-api.p.rapidapi.com",
      "method": "GET",
      "headers": {
        "X-RapidAPI-Key": "${RAPIDAPI_KEY}",
        "X-RapidAPI-Host": "youtube-info-download-api.p.rapidapi.com"
      },
      "rateLimit": "60/hour/ip"
    },
    "/yf/*": {
      "upstream": "https://www.youtube.com",
      "method": "GET",
      "rateLimit": "300/hour/ip"
    },
    "/gg/*": {
      "upstream": "https://www.google.com",
      "method": "GET",
      "rateLimit": "120/hour/ip"
    },
    "/yi/*": { "upstream": "https://i.ytimg.com", "method": "GET", "rateLimit": "5000/hour/ip" },
    "/yg/*": { "upstream": "https://yt3.ggpht.com", "method": "GET", "rateLimit": "5000/hour/ip" },
    "/yu/*": { "upstream": "https://yt3.googleusercontent.com", "method": "GET", "rateLimit": "1000/hour/ip" },
    "/gh/*": {
      "upstream": "https://api.github.com",
      "headers": {
        "Authorization": "Bearer ${GITHUB_EDIT_TOKEN}",
        "User-Agent": "vortex-engine-editor"
      },
      "rateLimit": "600/hour/ip"
    },
    "/ys/*": {
      "upstream": "https://youtube138.p.rapidapi.com",
      "method": "GET",
      "headers": {
        "X-RapidAPI-Key": "${RAPIDAPI_KEY}",
        "X-RapidAPI-Host": "youtube138.p.rapidapi.com"
      },
      "rateLimit": "300/hour/ip"
    }
  }
}
